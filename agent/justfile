# iris — task runner (stage 0.1 deliverable)
# Targets: fmt, lint, test, cov (plan §Phase 0.1)

default: help

help:
    @just --list

# Format all crates in check+apply mode
fmt:
    cargo fmt --all

# Format in check mode (what CI enforces — never mutates)
fmt-check:
    cargo fmt --all --check

# Clippy with -D warnings
lint:
    cargo clippy --all-targets --all-features -- -D warnings

# Full test suite (nextest if available, cargo test fallback)
test:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v cargo-nextest >/dev/null 2>&1 || cargo nextest --version >/dev/null 2>&1; then
      cargo nextest run --workspace --all-features
    else
      cargo test --workspace --all-features
    fi

# Coverage report (requires cargo-llvm-cov)
cov:
    cargo llvm-cov --workspace --all-features --html

# Single-binary smoke test (stage 7.4): the stripped release binary,
# copied ALONE into a temp dir, must run with a completely clean
# environment — no sidecar files, no ambient IRIS_* overrides, no key,
# no network. Proves the shipped artifact is self-contained. Shared
# with the GitHub Actions `smoke` job via scripts/smoke.sh.
smoke:
    bash scripts/smoke.sh

# Dependency audit (stage 7.4): RustSec advisories, license allowlist,
# wildcard bans, sources — requires cargo-deny (cargo install cargo-deny)
audit:
    cargo deny check

# Run everything CI runs (check mode — CI never mutates the tree)
ci: fmt-check lint test audit
